# Copie para backend/.env e preencha. NUNCA versione o arquivo .env.

# [Obrigatória] Conexão PostgreSQL do Supabase (driver asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:senha@host:5432/postgres

# [Obrigatória] URL do projeto Supabase (JWKS do login, cadastro e Storage).
SUPABASE_URL=https://seu-projeto.supabase.co

# [Obrigatória] Chave service_role, usada SOMENTE no backend:
#  - cadastro com perfil (Admin API do Supabase Auth);
#  - upload/remoção de fotos de avaliações no Storage.
# Nunca a coloque no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# [Opcional] Chave pública (anon). Só é usada pelo endpoint POST /auth/login;
# o frontend faz login direto no Supabase com VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=

# [Opcional] Origens do navegador autorizadas (CORS), separadas por vírgula.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# [Obsoleta] Não é mais utilizada: o JWT é validado pelas chaves públicas (JWKS).
# SUPABASE_JWT_SECRET=
