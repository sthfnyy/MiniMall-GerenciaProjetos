# Copie para frontend/.env e preencha. NUNCA versione o arquivo .env.

# [Obrigatória] Configuração pública do Supabase Auth usada pelo frontend.
VITE_SUPABASE_URL=
# Chave pública (anon). Nunca use a service_role aqui.
VITE_SUPABASE_ANON_KEY=

# [Opcional] URL base da API FastAPI (padrão: http://127.0.0.1:8000).
VITE_API_URL=http://127.0.0.1:8000

# [Obsoletas] Não utilizadas pelo código:
# VITE_DEMO_WHATSAPP, VITE_DEMO_INSTAGRAM — podem ser removidas do .env local.
